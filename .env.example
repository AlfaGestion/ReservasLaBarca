CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

# Base de datos local
database.default.hostname = localhost
database.default.database = alfagest_cancha
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Correo SMTP (las contraseñas reales deben permanecer solo en .env)
player.email.enabled = true
player.email.fromEmail = enviosalfagestion@gmail.com
player.email.fromName = "La Barca Centro Deportivo"
player.email.protocol = smtp
player.email.smtpHost = smtp.gmail.com
player.email.smtpPort = 587
player.email.smtpTimeout = 8
player.email.smtpCrypto = tls
player.email.account1.fromEmail = enviosreservaalfagestion@gmail.com
player.email.account1.fromName = "Reservas"
player.email.account1.smtpUser = enviosreservaalfagestion@gmail.com
player.email.account1.smtpPassword = PONER_CONTRASENA_DE_APLICACION
player.email.account2.fromEmail = enviosalfagestion@gmail.com
player.email.account2.fromName = "Reservas"
player.email.account2.smtpUser = enviosalfagestion@gmail.com
player.email.account2.smtpPassword = PONER_CONTRASENA_DE_APLICACION

# Seguridad de la aplicacion
encryption.key =
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

# Correo del portal y avisos de partidos (sin credenciales en el repositorio)
player.email.enabled = false
player.email.fromEmail =
player.email.fromName = La Barca Centro Deportivo
player.email.protocol = smtp
player.email.smtpHost = smtp.gmail.com
player.email.smtpUser =
player.email.smtpPassword =
player.email.smtpPort = 587
player.email.smtpCrypto = tls
player.email.smtpTimeout = 8

# Turnstile: obligatorio solamente si se configuran ambas claves
turnstile.siteKey =
turnstile.secretKey =
turnstile.required = false

# Para una demo temporal con ngrok, reemplazar solo durante la demo:
# app.baseURL = 'https://tu-subdominio.ngrok-free.app/'
